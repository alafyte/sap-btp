{
  "name": "order-service",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/ams": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/ams-dev": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-salesorderui": "cds watch --open salesorderui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/salesorderui"
  ],
  "cds": {
    "requires": {
      "[development]": {
        "auth": "mocked",
        "users": {
          "alice": {
            "roles": [
              "OrderManager"
            ]
          },
          "bob": {
            "roles": [
              "OrderViewer"
            ]
          },
          "*": false
        }
      },
      "[production]": {
        "auth": "ias",
        "db": "hana"
      }
    }
  },
  "engines": {
    "node": "^24"
  }
}